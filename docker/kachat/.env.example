# ============================================================================
# KaPosts indexer (KaChat-owned fork) — deployment config
# ============================================================================
# Builds the K crates from source (this repo) so the fork's changes ship:
#   - server-side U+2060 marker exclusivity (two-way KaChat-only)
#   - unvote / unquote removal counter-actions
#   - /get-post-engagement per-post actor lists
#   - K-admin ops/admin dashboard
#
# Reuses the mainnet rusty-kaspa node already running on this box
# (--utxoindex, BORSH wRPC on 17110). Bring up with:
#   cd K-indexer/docker/KAPOSTS && docker compose up -d --build
# ============================================================================

# Only the public-indexer profile ships here (no k-database-cleaner).
COMPOSE_PROFILES=public-indexer

# Mainnet — the app's KaPosts writes are live on mainnet.
NETWORK=mainnet

# Existing local node: BORSH wRPC endpoint.
KASPA_NODE_ADDRESS=127.0.0.1
KASPA_NODE_PORT=17110

# --- Database (host networking; ports chosen to avoid clashes on this box) ---
DB_USER=kaposts
DB_PASSWORD=change_me_before_prod
DB_NAME=kaposts-db
DB_PORT=5442

# --- Service ports ---
# K-webserver: fronted by nginx-proxy-manager at https://kaposts.duckdns.org (see DEPLOY.md).
# Bound to 0.0.0.0:3080 but only reachable on the LAN / via NPM (box is behind NAT).
WEBSERVER_PORT=3080
# K-admin dashboard: bound to 127.0.0.1 only. Reach via SSH tunnel:
#   ssh -L 3081:localhost:3081 <box>   then open http://localhost:3081
ADMIN_PORT=3081
# simply-kaspa-indexer local listen port (its own status endpoint)
SKI_PORT=8500
# Kasia chat indexer API port (avoids :8080 already used on this box)
CHAT_API_PORT=8600

# Shared secret for internal broadcast/KaPosts push injection
INTERNAL_PUSH_SECRET=

# --- FCM (Android push) ---
# Your Firebase project id (Firebase console → Project settings → General). The service-account
# private key JSON goes at /var/kachat-chat-data/fcm/service-account.json (mounts to
# /app/data/fcm/service-account.json). Leave empty to keep Android push disabled.
FCM_PROJECT_ID=
