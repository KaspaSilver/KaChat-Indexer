# ============================================================================
# KaChat Indexer — self-host config (install.sh generates a real .env from this,
# filling DB_PASSWORD and INTERNAL_PUSH_SECRET with fresh random values).
# ============================================================================

# public-indexer is the only profile in the self-host stack.
COMPOSE_PROFILES=public-indexer

# Network the bundled kaspad + indexer run on.
NETWORK=mainnet

# The bundled kaspad node's BORSH wRPC endpoint (host networking → 127.0.0.1:17110).
# Change these only if you point the app at a different/existing node.
KASPA_NODE_ADDRESS=127.0.0.1
KASPA_NODE_PORT=17110

# --- Database (host networking) ---
DB_USER=kachat
DB_PASSWORD=change_me
DB_NAME=kachat-db
DB_PORT=5442

# --- Service ports ---
WEBSERVER_PORT=3080   # public REST API (KaPosts + broadcasts)
ADMIN_PORT=3081       # admin dashboard (loopback only; reach via SSH tunnel)
SKI_PORT=8500         # block ingester status endpoint
CHAT_API_PORT=8600    # chat indexer API

# Shared secret guarding internal push-injection endpoints (install.sh randomizes this).
INTERNAL_PUSH_SECRET=

# --- FCM (Android push) — optional; leave empty to keep push disabled ---
FCM_PROJECT_ID=
