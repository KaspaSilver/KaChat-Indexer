# Build stage
FROM rust:1.91-alpine as builder

RUN apk add --no-cache musl-dev pkgconfig openssl-dev

WORKDIR /app

# Copy the workspace Cargo.toml and trim it to only include K-admin
COPY Cargo.toml ./
RUN sed -i '/members = \[/,/\]/c\members = ["K-admin"]' Cargo.toml

# Copy package files, source, and the embedded static dashboard (include_str! at build time)
COPY K-admin/Cargo.toml ./K-admin/
COPY K-admin/src ./K-admin/src
COPY K-admin/static ./K-admin/static

RUN cargo build --release --bin K-admin

# Runtime stage
FROM alpine:3.19

RUN apk add --no-cache ca-certificates libssl3
RUN adduser -D -s /bin/sh app
WORKDIR /app

COPY --from=builder /app/target/release/K-admin /app/
RUN chown -R app:app /app
USER app

EXPOSE 3081
ENTRYPOINT ["./K-admin"]
